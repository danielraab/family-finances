# Environment variables for the backend.
#
# Go does not auto-load this file. Export the vars yourself, e.g.
#   set -a; source .env; set +a
# or use direnv.

# Port the HTTP server listens on.
PORT=8080

# PostgreSQL connection string. REQUIRED — no default. The backend logs an
# error and exits if this is unset or the database is unreachable at startup.
# For local development, start the database with `docker compose up -d db` from
# the repo root, which serves this DSN:
DATABASE_URL=postgres://familyfinances:familyfinances@localhost:5432/familyfinances?sslmode=disable

# --- Authentication ---------------------------------------------------------

# Externally reachable origin of this backend. Builds magic-link URLs and the
# OIDC redirect_uri. REQUIRED for auth to work; no default.
AUTH_BASE_URL=http://localhost:8080

# Session lifetime. AUTH_SESSION_TTL slides forward on use; AUTH_SESSION_MAX_TTL
# is the absolute cap after which a session is rejected regardless of activity.
# Go duration syntax (e.g. 720h, 30m).
AUTH_SESSION_TTL=720h
AUTH_SESSION_MAX_TTL=2160h

# Set the Secure attribute on the ff_session cookie. Set to false only for
# local http development.
AUTH_COOKIE_SECURE=true

# Account-creation policy. AUTH_SIGNUP_ENABLED gates new accounts (invite
# acceptance and the first-ever user ignore it). AUTH_ALLOWED_EMAIL_DOMAINS is
# a comma-separated allow-list checked only at account creation; empty = any
# domain. AUTH_INVITE_ENABLED only matters once signup is disabled — while
# signup is on, any authenticated user can invite.
AUTH_SIGNUP_ENABLED=true
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_INVITE_ENABLED=true

# Token lifetimes (Go duration syntax).
AUTH_INVITE_TTL=168h
AUTH_MAGIC_LINK_TTL=15m

# --- SMTP (magic-link and invite email) -----------------------------------

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=fafi@localhost
# Transport security: one of starttls (default, port 587), implicit (port 465),
# or none (no TLS — local dev only).
SMTP_TLS=none

# --- OIDC (single provider) ---------------------------------------------------

# Issuer URL; its .well-known/openid-configuration is fetched at startup.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated scopes. Default: openid,email,profile
OIDC_SCOPES=openid,email,profile
# Text shown on the OIDC sign-in button on the login page. Only shown when
# OIDC_ISSUER and OIDC_CLIENT_ID are both set. Default: Single sign-on
OIDC_LABEL=
